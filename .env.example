# Configuration Ollama
OLLAMA_BASE_URL=http://localhost:11434
MODEL_PLANNER=qwen3:14b
MODEL_CODER=qwen2.5-coder:7b
MODEL_EMBEDDING=nomic-embed-text

# Limites d'exécution et de révision
MAX_TOOL_CALLS=5
MAX_REVISIONS=2

# Recherche Web (SearXNG local ou API optionnelle)
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# Sécurité et Approbation Humaine (Human-in-the-Loop)
REQUIRE_HUMAN_APPROVAL=false

# Chemins de stockage local
SQLITE_DB_PATH=data/app.db
CHROMA_PERSIST_DIR=data/chroma

# Configuration API et Serveur
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Limites globales par tâche
MAX_STEPS=10
MAX_WEB_SEARCHES=5
MAX_PAGES_READ=30
MAX_TOKENS=50000
MAX_SECONDS=600

# Contexte du modèle (tokens) et mode réflexion de qwen3
NUM_CTX=8192
MAX_OUTPUT_TOKENS=2048
OLLAMA_THINK=false

# Étapes indépendantes exécutées en parallèle (1 = séquentiel)
MAX_PARALLEL_STEPS=2

# Option Claude (Phase 9) : planificateur et critique via l'API Anthropic si une clé est fournie
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
