# Fins de ligne : LF dans le dépôt, conversion automatique selon le système
* text=auto

# Scripts Windows : toujours en CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires : jamais modifiés par Git
*.pdf  binary
*.docx binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.db   binary
